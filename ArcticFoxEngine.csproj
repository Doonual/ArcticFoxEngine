<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net6.0-windows</TargetFramework>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Platforms>x64;x86</Platforms>
		<NoWarn>1701;1702</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Remove=".gitignore" />
		<None Remove="Gui\ImGui\build\net40\ImGui.NET.targets" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SharpDX" Version="4.2.0" />
		<PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
		<PackageReference Include="SharpDX.Desktop" Version="4.2.0">
			<NoWarn>NU1701</NoWarn>
		</PackageReference>
		<PackageReference Include="SharpDX.Direct3D12" Version="4.2.0" />
		<PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
		<PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
		<PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
		<PackageReference Include="SharpDX.RawInput" Version="4.2.0">
		  <NoWarn>NU1701</NoWarn>
		</PackageReference>
		<PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />
	</ItemGroup>
	
	
	<ItemGroup>
		<Content Include=".res\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	
	
	<ItemGroup>
	  <Compile Remove="ArcticFoxEngine Documentation\**" />
	  <EmbeddedResource Remove="ArcticFoxEngine Documentation\**" />
	  <None Remove="ArcticFoxEngine Documentation\**" />
	</ItemGroup>

	<ItemGroup>

		<Content Include="cimgui\win-x64\cimgui.dll" Condition=" '$(Platform)' == 'x64' ">
			<PackagePath>runtimes/win-x64/native</PackagePath>
			<Pack>true</Pack>
			<Link>cimgui.dll</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		
		<Content Include="cimgui\win-x86\cimgui.dll" Condition=" '$(Platform)' == 'x86' ">
			<PackagePath>runtimes/win-x86/native</PackagePath>
			<Pack>true</Pack>
			<Link>cimgui.dll</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>

		<Content Include="cimgui\win-arm64\cimgui.dll" Condition=" '$(Platform)' == 'ARM64' ">
			<PackagePath>runtimes/win-arm64/native</PackagePath>
			<Pack>true</Pack>
			<Link>cimgui.dll</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>

	</ItemGroup>
	
	<ItemGroup>
	  <None Include=".res\icon.ico" />
	  <None Include=".res\Shaders\Mandelbrot\MandelbrotPixelShader.hlsl" />
	  <None Include=".res\Shaders\Unlit\PixelShader.hlsl" />
	  <None Include=".res\Shaders\Common.hlsl" />
	</ItemGroup>
	
	
	<ItemGroup>
	  <ProjectReference Include="..\CoolClassLibrary\CoolClassLibrary.csproj" />
	</ItemGroup>
	
	
	<ItemGroup>
	  <None Update="Demos\ComputeTest\gol_compute.hlsl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
	
	
	<ItemGroup>
	  <Folder Include=".res\ComputeShaders\" />
	</ItemGroup>


</Project>