{
  "nodes": [
    {
      "id": "0269e235b817c647",
      "type": "text",
      "text": "The mesh renderer will have a material that will fully determine how its rendered",
      "styleAttributes": {},
      "x": 120,
      "y": -340,
      "width": 300,
      "height": 100
    },
    {
      "id": "624480ca5af0add5",
      "type": "text",
      "text": "Each shaders will encompass a pipeline state object",
      "styleAttributes": {},
      "x": -280,
      "y": -100,
      "width": 320,
      "height": 80
    },
    {
      "id": "f2de66709783299c",
      "type": "text",
      "text": "Materials store and set the properties for the shaders",
      "styleAttributes": {},
      "x": 105,
      "y": -100,
      "width": 330,
      "height": 60
    },
    {
      "id": "309257dbccf5995d",
      "type": "text",
      "text": "Materials will be an implementation of an abstract type",
      "styleAttributes": {},
      "x": 500,
      "y": -100,
      "width": 320,
      "height": 60
    },
    {
      "id": "1433a79237014001",
      "type": "text",
      "text": "Material will be specific to a shader",
      "styleAttributes": {},
      "x": 375,
      "y": 80,
      "width": 250,
      "height": 60
    },
    {
      "id": "fdeda8ff0aa0064a",
      "type": "text",
      "text": "Lit material for lit shader\nSkybox material for skybox shader",
      "styleAttributes": {},
      "x": 540,
      "y": 260,
      "width": 320,
      "height": 60
    },
    {
      "id": "f017c0d37b1c1445",
      "type": "text",
      "text": "Full control over how the object is rendered",
      "styleAttributes": {},
      "x": -468,
      "y": 165,
      "width": 250,
      "height": 60
    },
    {
      "id": "6e6b5c4e01658429",
      "type": "text",
      "text": "Shaders will submit a pipeline state object",
      "styleAttributes": {},
      "x": -593,
      "y": 460,
      "width": 250,
      "height": 60
    },
    {
      "id": "ba1aab95fc3d56d2",
      "type": "text",
      "text": "Shaders will take in a material and bind all the necessary data to the shader",
      "styleAttributes": {},
      "x": -280,
      "y": 460,
      "width": 320,
      "height": 60
    },
    {
      "id": "3608900443027c63",
      "type": "text",
      "text": "Under the hood rendering",
      "styleAttributes": {},
      "x": -593,
      "y": 360,
      "width": 633,
      "height": 60,
      "color": "2"
    },
    {
      "id": "e22f45e2bded1719",
      "type": "text",
      "text": "Camera",
      "styleAttributes": {
        "textAlign": "center"
      },
      "x": -1140,
      "y": 720,
      "width": 200,
      "height": 60,
      "color": "1"
    },
    {
      "id": "f418d5c99e26e01c",
      "type": "text",
      "text": "Rendering",
      "styleAttributes": {
        "textAlign": "center"
      },
      "x": -740,
      "y": 720,
      "width": 260,
      "height": 60,
      "color": "2"
    },
    {
      "id": "b3ba7b46317ba6ac",
      "type": "text",
      "text": "Calls Rendering.RenderScene",
      "styleAttributes": {},
      "x": -1170,
      "y": 860,
      "width": 260,
      "height": 60,
      "color": "1"
    },
    {
      "id": "dcbdc0706e0da41c",
      "type": "text",
      "text": "Calls camera.UpdateCameraInfoBuffer",
      "styleAttributes": {},
      "x": -740,
      "y": 920,
      "width": 260,
      "height": 100,
      "color": "2"
    },
    {
      "id": "b7ec67939efb6708",
      "type": "text",
      "text": "Write camera projection info to ConstBuffer",
      "styleAttributes": {},
      "x": -1170,
      "y": 1100,
      "width": 260,
      "height": 60,
      "color": "1"
    },
    {
      "id": "dc27c3c623d2bb83",
      "type": "text",
      "text": "GeometryInfo",
      "styleAttributes": {
        "textAlign": "center"
      },
      "x": -320,
      "y": 720,
      "width": 260,
      "height": 60,
      "color": "3"
    },
    {
      "id": "ac5143f87e4fa52f",
      "type": "text",
      "text": "Wait for copy command queue to finish",
      "styleAttributes": {},
      "x": -720,
      "y": 1180,
      "width": 260,
      "height": 60,
      "color": "2"
    },
    {
      "id": "c234e65617e65b9c",
      "type": "text",
      "text": "Wait for direct command queue to finish",
      "styleAttributes": {},
      "x": -720,
      "y": 1300,
      "width": 260,
      "height": 60,
      "color": "2"
    },
    {
      "id": "a28540ea7cb84bdf",
      "type": "text",
      "text": "Reset direct command queue",
      "styleAttributes": {},
      "x": -720,
      "y": 1440,
      "width": 260,
      "height": 60,
      "color": "2"
    },
    {
      "id": "620b70b3111a2295",
      "type": "text",
      "text": "Loop over all the shaders",
      "styleAttributes": {},
      "x": -720,
      "y": 1780,
      "width": 260,
      "height": 60,
      "color": "2"
    },
    {
      "id": "a8c5a02413f11a1b",
      "type": "text",
      "text": "Bind the gpuDescriptorHeap",
      "styleAttributes": {},
      "x": -720,
      "y": 1600,
      "width": 260,
      "height": 80,
      "color": "2"
    },
    {
      "id": "1d7c83e592dd828d",
      "type": "text",
      "text": "Shader",
      "styleAttributes": {
        "textAlign": "center"
      },
      "x": 120,
      "y": 720,
      "width": 260,
      "height": 60,
      "color": "4"
    },
    {
      "id": "cddab39eb994d81e",
      "type": "text",
      "text": "Material",
      "styleAttributes": {
        "textAlign": "center"
      },
      "x": 540,
      "y": 720,
      "width": 260,
      "height": 60,
      "color": "5"
    },
    {
      "id": "49ce61d48bafcba4",
      "type": "text",
      "text": "Write transform and inverse transform matrix of each object to the buffer \"objectBuffer\"",
      "styleAttributes": {},
      "x": 260,
      "y": 1860,
      "width": 260,
      "height": 120,
      "color": "3"
    },
    {
      "id": "e66b052156d3773f",
      "type": "text",
      "text": "Call Shader.Render on the current shader",
      "styleAttributes": {},
      "x": -200,
      "y": 2060,
      "width": 260,
      "height": 60,
      "color": "2"
    },
    {
      "id": "0d296cd7cb2dc9bf",
      "type": "text",
      "text": "Set the pipeline state object",
      "styleAttributes": {},
      "x": 640,
      "y": 2200,
      "width": 260,
      "height": 60,
      "color": "4"
    },
    {
      "id": "9eaa111aadd4d2f9",
      "type": "text",
      "text": "Set the root signature",
      "styleAttributes": {},
      "x": 640,
      "y": 2340,
      "width": 260,
      "height": 60,
      "color": "4"
    },
    {
      "id": "43bf17a7d4d582b8",
      "type": "text",
      "text": "Bind the 1st index of the Rendering.renderInfo buffer to the \"Camera info\" dataslot",
      "styleAttributes": {},
      "x": 640,
      "y": 2500,
      "width": 260,
      "height": 120,
      "color": "4"
    },
    {
      "id": "d17dab48e02cbf35",
      "type": "text",
      "text": "Call SetGlobalData of the specific shader. This is things like sun direction for the Lit shader",
      "styleAttributes": {},
      "x": 640,
      "y": 2700,
      "width": 260,
      "height": 120,
      "color": "4"
    },
    {
      "id": "7dfe6480bb9c2b7a",
      "type": "text",
      "text": "Set the viewport and scissor rectangles",
      "styleAttributes": {},
      "x": 640,
      "y": 2950,
      "width": 260,
      "height": 60,
      "color": "4"
    },
    {
      "id": "45adf353c7e15f9a",
      "type": "text",
      "text": "ResourceBarrierTransition the renderTarget from Present to RenderTarget",
      "styleAttributes": {},
      "x": 640,
      "y": 3120,
      "width": 260,
      "height": 100,
      "color": "4"
    },
    {
      "id": "5051560d690de791",
      "type": "text",
      "text": "Set the render and depth textures as the render targets",
      "styleAttributes": {},
      "x": 640,
      "y": 3280,
      "width": 260,
      "height": 100,
      "color": "4"
    },
    {
      "id": "e60403a125efcc93",
      "type": "text",
      "text": "Optionally clear the render texture and depth texture",
      "styleAttributes": {},
      "x": 640,
      "y": 3500,
      "width": 260,
      "height": 60,
      "color": "4"
    },
    {
      "id": "c28205fcbaef2aa8",
      "type": "text",
      "text": "Set the vertex and index buffers",
      "styleAttributes": {},
      "x": 640,
      "y": 3700,
      "width": 260,
      "height": 60,
      "color": "4"
    },
    {
      "id": "cdf2db1f5995cfde",
      "type": "text",
      "text": "Bind the \"objectBuffer\" element corresponding to the current MeshRenderer to the \"Object info\" dataslot",
      "styleAttributes": {},
      "x": 1020,
      "y": 3870,
      "width": 260,
      "height": 160,
      "color": "4"
    },
    {
      "id": "6ee3aa3d8ec02499",
      "type": "text",
      "text": "Loop over all the MeshRenderers assigned to this shader",
      "styleAttributes": {},
      "x": 640,
      "y": 3900,
      "width": 260,
      "height": 100,
      "color": "4"
    },
    {
      "id": "6372492f64dd0b8a",
      "type": "text",
      "text": "ResourceBarrierTransition the renderTarget from RenderTarget to Present",
      "styleAttributes": {},
      "x": 640,
      "y": 4140,
      "width": 260,
      "height": 120,
      "color": "4"
    },
    {
      "id": "d1cb8b2bd43edb1f",
      "type": "text",
      "text": "Retrieve the material for the current MeshRenderer and call Material.BindResources",
      "styleAttributes": {},
      "x": 1360,
      "y": 3890,
      "width": 260,
      "height": 120,
      "color": "4"
    },
    {
      "id": "c670b00c2255bbde",
      "type": "text",
      "text": "Bind the MeshRenderer specific values to the shader specific dataslots",
      "styleAttributes": {},
      "x": 1540,
      "y": 4160,
      "width": 260,
      "height": 100,
      "color": "5"
    },
    {
      "id": "b7068ef46d546a2c",
      "type": "text",
      "text": "Actually set the data associated with the dataslots",
      "styleAttributes": {},
      "x": 1720,
      "y": 3890,
      "width": 260,
      "height": 100,
      "color": "4"
    },
    {
      "id": "09fbdaf5b105e661",
      "type": "text",
      "text": "Draw call",
      "styleAttributes": {},
      "x": 2120,
      "y": 3910,
      "width": 260,
      "height": 60,
      "color": "4"
    },
    {
      "id": "202485b839a5db91",
      "type": "text",
      "text": "Call GeometryInfo.UpdateObjectInfoBuffer",
      "styleAttributes": {},
      "x": -240,
      "y": 1760,
      "width": 340,
      "height": 100,
      "color": "2"
    },
    {
      "id": "82a066c39dc06c02",
      "type": "text",
      "text": "Execute the command list",
      "styleAttributes": {},
      "x": -720,
      "y": 2260,
      "width": 260,
      "height": 60,
      "color": "2"
    },
    {
      "id": "e9b090979d3480a9",
      "type": "text",
      "text": "Close the command list",
      "styleAttributes": {},
      "x": -720,
      "y": 2060,
      "width": 260,
      "height": 60,
      "color": "2"
    },
    {
      "id": "ecdac5827cd32c37",
      "type": "text",
      "text": "Finished",
      "styleAttributes": {},
      "x": -1160,
      "y": 2340,
      "width": 260,
      "height": 60,
      "color": "1"
    }
  ],
